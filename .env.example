# ====================================================================
# Dehradun Defence College - Environment Configuration Template
# Rename this file to `.env` on your production server.
# NEVER commit your real `.env` file containing passwords to Git.
# ====================================================================

# Website Environment & Base URL
APP_ENV=production
SITE_URL=https://dehradundefencecollege.com

# Recipient Email for Admission Enquiries
ADMIN_ENQUIRY_EMAIL=dehradundefencecollege@gmail.com

# SMTP Server Settings (for transactional & notification emails)
# Set SMTP_ENABLED to true once valid SMTP credentials are configured.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=your_smtp_username_or_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM_EMAIL=admissions@dehradundefencecollege.com
SMTP_FROM_NAME="Dehradun Defence College Admissions"

# Security & Anti-CSRF Token Key (change to a random 32-character string)
CSRF_SECRET=ddc_secret_token_change_this_in_production_2026_xyz

# Optional Database Configuration (for standalone leads table)
DB_ENABLED=false
DB_HOST=localhost
DB_NAME=ddc_admissions
DB_USER=ddc_user
DB_PASS=your_db_password
